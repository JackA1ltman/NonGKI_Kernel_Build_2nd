From bc23096b9df4d76c43bfea9e217978ecc93b94d4 Mon Sep 17 00:00:00 2001
From: sidex15 <noreply@github.com>
Date: Tue, 21 Jul 2020 22:28:09 +0000
Subject: [PATCH] mm: susfs: fix memfd handling for SUSFS

Fix memfd handling for SUSFS to avoid double free and ensure correct
reference counting when memfd-backed files are used.

Signed-off-by: sidex15 <noreply@github.com>
---
 fs/susfs/file.c | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/fs/susfs/file.c b/fs/susfs/file.c
index 3a2b1f2..7d9c4e5 100644
--- a/fs/susfs/file.c
+++ b/fs/susfs/file.c
@@ -12,20 +12,30 @@
 #include <linux/fs.h>
 #include <linux/mount.h>
 #include <linux/slab.h>
+#include <linux/memfd.h>
 
 struct susfs_file {
     struct file *backing_file;
     struct inode *inode;
     atomic_t refcount;
 };
 
 static struct file *susfs_get_backing_file(struct file *file)
 {
-    if (!file)
-        return NULL;
-
-    get_file(file);
-    return file;
+    struct file *f = file;
+
+    if (!f)
+        return NULL;
+
+    /*
+     * If this is a memfd-backed file, use memfd_get_file to properly
+     * handle the memfd reference counting. Otherwise fall back to
+     * generic get_file().
+     */
+    if (is_memfd_file(f))
+        return memfd_get_file(f);
+
+    get_file(f);
+    return f;
 }
 
 static void susfs_put_backing_file(struct file *file)
 {
-    if (!file)
-        return;
-
-    fput(file);
+    if (!file)
+        return;
+
+    /*
+     * memfd_get_file increments memfd specific references; fput is still
+     * the correct way to drop the struct file reference for both memfd
+     * and non-memfd files.
+     */
+    fput(file);
 }
 
 struct susfs_file *susfs_file_create(struct file *backing)
 {
@@ -40,7 +50,11 @@ struct susfs_file *susfs_file_create(struct file *backing)
     sf->inode = file_inode(backing);
     atomic_set(&sf->refcount, 1);
 
-    sf->backing_file = susfs_get_backing_file(backing);
+    /* Acquire proper reference to backing file */
+    sf->backing_file = susfs_get_backing_file(backing);
+    if (!sf->backing_file) {
+        kfree(sf);
+        return ERR_PTR(-ENOMEM);
+    }
 
     return sf;
 }
 
