diff --git a/infra/kernel_compat.h b/infra/kernel_compat.h
index 5b10ee7..a6cc583 100644
--- a/infra/kernel_compat.h
+++ b/infra/kernel_compat.h
@@ -1,6 +1,23 @@
 #ifndef __KSU_H_KERNEL_COMPAT
 #define __KSU_H_KERNEL_COMPAT
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 4, 0)
+
+#ifndef __has_attribute
+#define __has_attribute(x) __GCC4_has_attribute_##x
+#define __GCC4_has_attribute__fallthrough__ 0
+#endif
+
+#ifndef fallthrough
+#if __has_attribute(__fallthrough__)
+#define fallthrough __attribute__((__fallthrough__))
+#else
+#define fallthrough do { } while (0) /* fallthrough */
+#endif
+#endif
+
+#endif // LINUX_VERSION_CODE < 5.4.0
+
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 9, 0)) && (LINUX_VERSION_CODE < KERNEL_VERSION(4, 10, 0)) ||              \
     (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 14, 0)) && (LINUX_VERSION_CODE < KERNEL_VERSION(4, 15, 0))
 #ifdef HISI_SELINUX_EBITMAP_RO
@@ -11,6 +28,26 @@
 #if LINUX_VERSION_CODE < KERNEL_VERSION(4, 10, 0) || defined(CONFIG_IS_HW_HISI) ||                                     \
     defined(CONFIG_KSU_ALLOWLIST_WORKAROUND)
 
+#ifndef strncpy_from_user_nofault
+#define strncpy_from_user_nofault ksu_strncpy_from_user_nofault
+#endif
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 1, 0)
+
+#ifndef KSU_HAS_SELINUX_INODE
+#define selinux_inode(inode) ((struct inode_security_struct *)((inode)->i_security))
+#endif
+
+#ifndef KSU_HAS_SELINUX_CRED
+#define selinux_cred(cred) ((struct cred_security_struct *)((cred)->i_security))
+#endif
+
+#ifndef current_sid
+#define current_sid() (((struct cred_security_struct *)current_security())->sid)
+#endif
+
+#endif
+
 extern int install_session_keyring_to_cred(struct cred *cred, struct key *keyring);
 static struct key *init_session_keyring = NULL;
 
